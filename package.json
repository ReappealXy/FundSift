{
  "name": "fundsift",
  "version": "0.2.0-preview.5",
  "private": true,
  "author": "东启",
  "description": "东启勘流：本地资金流水分析工作台",
  "main": "code/desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "test": "node scripts/check.cjs && node --test scripts/g0/checks/validator.test.cjs",
    "test:g0": "node --test scripts/g0/checks/validator.test.cjs",
    "test:storage": "node scripts/run-electron-node.cjs --test code/desktop/checks/storage.check.cjs",
    "smoke": "node scripts/smoke.cjs",
    "build:dir": "electron-builder --win --x64 --dir",
    "build": "electron-builder --win portable --x64"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "better-sqlite3": "12.11.1",
    "exceljs": "4.4.0",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "electron": "42.11.18",
    "electron-builder": "26.18.0",
    "jsdom": "27.4.0"
  },
  "build": {
    "appId": "cn.dongqi.fundsift",
    "productName": "FundSift",
    "directories": {
      "output": "dist"
    },
    "files": [
      "code/desktop/**/*.cjs",
      "code/desktop/assets/**",
      "!code/desktop/checks/**",
      "code/ddl_extract_check.sql",
      "code/prototype/*.html",
      "!code/prototype/index.legacy.html",
      "code/prototype/*.css",
      "code/prototype/*.js",
      "code/prototype/assets/**",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**"
    ],
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": [
        "portable"
      ],
      "icon": "code/desktop/assets/icon.ico",
      "signExecutable": false
    },
    "artifactName": "FundSift-${version}-win-${arch}.${ext}"
  }
}
