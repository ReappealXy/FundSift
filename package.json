{
  "name": "fundsift",
  "version": "0.2.0-preview.9",
  "private": true,
  "author": "眉山东启会计师事务所（普通合伙）",
  "description": "东启勘流是一款面向审计与资金核查的本地桌面软件。支持按案件导入指定格式的银行、微信支付和支付宝流水，逐笔核对异常、追溯原始记录，并导出 Excel 核对底稿。案件与材料保存在本机，供事务所内部使用。",
  "main": "code/desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "test": "node scripts/check.cjs && node --test scripts/g0/checks/validator.test.cjs",
    "test:g0": "node --test scripts/g0/checks/validator.test.cjs",
    "test:storage": "node scripts/run-electron-node.cjs --test code/desktop/checks/storage.check.cjs",
    "smoke": "node scripts/smoke.cjs",
    "build:dir": "electron-builder --win --x64 --dir",
    "build": "electron-builder --win nsis --x64 --publish never",
    "build:portable": "electron-builder --win portable --x64 --publish never"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "better-sqlite3": "12.11.1",
    "exceljs": "4.4.0",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "electron": "42.11.18",
    "electron-builder": "26.18.0",
    "jsdom": "27.4.0"
  },
  "build": {
    "appId": "cn.dongqi.fundsift",
    "productName": "FundSift",
    "directories": {
      "output": "dist",
      "buildResources": "scripts/installer"
    },
    "files": [
      "code/desktop/**/*.cjs",
      "code/desktop/assets/**",
      "!code/desktop/checks/**",
      "code/ddl_extract_check.sql",
      "code/prototype/*.html",
      "!code/prototype/index.legacy.html",
      "code/prototype/*.css",
      "code/prototype/*.js",
      "code/prototype/assets/**",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**"
    ],
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "code/desktop/assets/icon.ico",
      "signExecutable": false
    },
    "artifactName": "FundSift-${version}-win-${arch}.${ext}",
    "afterPack": "./scripts/installer/fundsift-install-files.cjs",
    "nsis": {
      "artifactName": "FundSift-${version}-win-${arch}-setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "packElevateHelper": false,
      "installerLanguages": [
        "zh_CN"
      ],
      "shortcutName": "东启勘流",
      "uninstallDisplayName": "东启勘流 (${version})",
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false
    }
  }
}
