{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fundsift.local/schemas/g0/bundle-v1",
  "title": "G0 v1 local dataset contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "matrix_version",
    "dataset_id",
    "dataset_version",
    "state",
    "generator",
    "answers_file",
    "answers_sha256",
    "schema_sha256",
    "matrix_sha256",
    "sources",
    "rules",
    "questions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "matrix_version": {
      "const": 2
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "dataset_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "state": {
      "enum": [
        "draft",
        "frozen"
      ]
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "implementation_path",
        "sha256",
        "independence"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "implementation_path": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "independence": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "answers_file": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "answers_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "matrix_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "path",
          "file_name",
          "size",
          "sha256",
          "platform",
          "format",
          "account_ref",
          "time_range",
          "observations",
          "rule_id",
          "rule_version",
          "disposition",
          "review",
          "case_ref",
          "sample_role",
          "record_index"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "kind": {
            "enum": [
              "real",
              "synthetic"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "file_name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "platform": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "format": {
            "enum": [
              "xlsx",
              "csv",
              "txt",
              "unknown"
            ]
          },
          "account_ref": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "time_range": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "to": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "observations": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "encoding",
              "bom",
              "merged_cells",
              "logical_records",
              "header_records",
              "footer_records",
              "other_non_data_records",
              "data_records"
            ],
            "properties": {
              "encoding": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "bom": {
                "enum": [
                  true,
                  false,
                  null
                ]
              },
              "merged_cells": {
                "enum": [
                  true,
                  false,
                  null
                ]
              },
              "logical_records": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "header_records": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "footer_records": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "other_non_data_records": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "data_records": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            }
          },
          "rule_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "rule_version": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "disposition": {
            "enum": [
              "rows",
              "unrecognized"
            ]
          },
          "review": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "by",
              "at",
              "reason"
            ],
            "properties": {
              "status": {
                "enum": [
                  "unreviewed",
                  "approved"
                ]
              },
              "by": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "at": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reason": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "case_ref": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "sample_role": {
            "enum": [
              "ccb_xlsx",
              "wechat_txt",
              "alipay_account_csv",
              "alipay_balance_csv",
              "case_b_reversal",
              "boundary",
              "other"
            ]
          },
          "record_index": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256",
                  "extractor"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "extractor": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "name",
                      "version",
                      "implementation_path",
                      "sha256",
                      "independent_of_parser"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "version": {
                        "type": "string",
                        "minLength": 1
                      },
                      "implementation_path": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "independent_of_parser": {
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "rule_version",
          "platform",
          "format_key",
          "amount_expr",
          "source_unit",
          "unit_scale",
          "rounding_rule",
          "direction_map",
          "negative_policy",
          "zero_policy",
          "zero_direction",
          "balance_scope",
          "balance_same_direction",
          "currency_policy",
          "reversal_note",
          "review"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "rule_version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "platform": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "format_key": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "amount_expr": {
            "enum": [
              "A",
              "B",
              "C",
              "D",
              "E",
              "F"
            ]
          },
          "source_unit": {
            "enum": [
              "元",
              "分"
            ]
          },
          "unit_scale": {
            "enum": [
              1,
              100
            ]
          },
          "rounding_rule": {
            "const": "ROUND_HALF_UP"
          },
          "direction_map": {
            "type": "object",
            "additionalProperties": {
              "enum": [
                "进",
                "出"
              ]
            }
          },
          "negative_policy": {
            "enum": [
              "signed",
              "reverse",
              "magnitude",
              "column_defined",
              "pending"
            ]
          },
          "zero_policy": {
            "enum": [
              "pending",
              "confirmed"
            ]
          },
          "zero_direction": {
            "enum": [
              "进",
              "出",
              null
            ]
          },
          "balance_scope": {
            "enum": [
              "asset_ledger",
              "debt",
              "available",
              "unknown"
            ]
          },
          "balance_same_direction": {
            "type": "boolean"
          },
          "currency_policy": {
            "enum": [
              "explicit",
              "verified_cny",
              "unverified"
            ]
          },
          "reversal_note": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "review": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "by",
              "at",
              "reason"
            ],
            "properties": {
              "status": {
                "enum": [
                  "unreviewed",
                  "approved"
                ]
              },
              "by": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "at": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reason": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "question",
          "affected",
          "options",
          "recommendation",
          "decision",
          "decided_by",
          "decided_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "status": {
            "enum": [
              "open",
              "resolved"
            ]
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "affected": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_id",
                "source_loc"
              ],
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "source_loc": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          },
          "recommendation": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "decision": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "decided_by": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "decided_at": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_sha256",
        "source_loc",
        "format_rule_id",
        "rule_version",
        "layer",
        "raw",
        "expected",
        "basis",
        "review",
        "coverage",
        "question_ids"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_loc": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "format_rule_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "rule_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "layer": {
          "enum": [
            "A",
            "B"
          ]
        },
        "raw": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "raw_amount_text",
            "raw_direction",
            "raw_balance_text",
            "raw_income_text",
            "raw_expense_text",
            "txn_time_text",
            "acct_no",
            "currency_text",
            "summary"
          ],
          "properties": {
            "raw_amount_text": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            },
            "raw_direction": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            },
            "raw_balance_text": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            },
            "raw_income_text": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            },
            "raw_expense_text": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            },
            "txn_time_text": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            },
            "acct_no": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            },
            "currency_text": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            },
            "summary": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "amount",
            "direction",
            "status",
            "pending_reason",
            "balance",
            "balance_scope",
            "currency",
            "txn_time",
            "acct_no",
            "reversal_flag",
            "balance_check"
          ],
          "properties": {
            "amount": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "string",
                  "pattern": "^(?:0|-[1-9][0-9]*|[1-9][0-9]*)$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "direction": {
              "enum": [
                "进",
                "出",
                null
              ]
            },
            "status": {
              "enum": [
                "confirmed",
                "pending"
              ]
            },
            "pending_reason": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "reason_code",
                  "detail"
                ],
                "properties": {
                  "reason_code": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "detail": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                }
              }
            },
            "balance": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "string",
                  "pattern": "^(?:0|-[1-9][0-9]*|[1-9][0-9]*)$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "balance_scope": {
              "enum": [
                "asset_ledger",
                "debt",
                "available",
                "unknown"
              ]
            },
            "currency": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Z]{3}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "txn_time": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            },
            "acct_no": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            },
            "reversal_flag": {
              "enum": [
                0,
                1
              ]
            },
            "balance_check": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "comparable",
                "reason",
                "previous",
                "expect_balance",
                "diff",
                "segment_complete",
                "order"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "unchecked",
                    "pass",
                    "fail",
                    "na"
                  ]
                },
                "comparable": {
                  "type": "boolean"
                },
                "reason": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "previous": {
                  "anyOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "source_id",
                        "source_loc"
                      ],
                      "properties": {
                        "source_id": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "\\S"
                        },
                        "source_loc": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "\\S"
                        }
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "expect_balance": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "string",
                      "pattern": "^(?:0|-[1-9][0-9]*|[1-9][0-9]*)$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "diff": {
                  "anyOf": [
                    {
                      "type": "integer",
